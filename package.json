{
  "name": "node-typescript-seed",
  "version": "1.0.0",
  "description": "A TypeScript boilerplate for Node.js projects, featuring ready-to-use scripts, separate build profiles, dependency injection, and testing with Jest.",
  "main": "app.js",
  "scripts": {
    "start": "npm run start:debug",
    "start:debug": "npx ts-node --project tsconfig.debug.json ./src/app.ts",
    "start:release": "npm run build:release && node dist/app.js",
    "watch": "npm run watch:debug",
    "watch:debug": "npx nodemon",
    "build": "npm run build:release",
    "build:debug": "npm run clear && tsc --project tsconfig.debug.json",
    "build:release": "npm run clear && tsc --project tsconfig.release.json",
    "clear": "rimraf ./dist",
    "update-packages": "npm run update-packages:minor",
    "update-packages:check": "npx -- npm-check-updates",
    "update-packages:major": "npx -- npm-check-updates --target latest -u",
    "update-packages:minor": "npx -- npm-check-updates --target minor -u",
    "update-packages:patch": "npx -- npm-check-updates --target patch -u",
    "test": "jest ./tests --coverage=false",
    "test:watch": "jest ./tests --coverage=false --watch=true",
    "test:coverage": "jest ./tests --coverage"
  },
  "keywords": ["nodejs","typescript","jest","seed","template","boilerplate"],
  "author": "paulosincos@hotmail.com",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.5.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "npm-check-updates": "^19.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
